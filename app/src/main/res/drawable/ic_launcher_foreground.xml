<?xml version="1.0" encoding="utf-8"?>
<!-- Icône VYLIA : une loupe d'audit et une coche, l'idée du scan qui rassure (ni cadenas, ni bouclier, ni alerte).
     Centrée dans la zone sûre de 66dp des icônes adaptatives ; une seule couleur par forme pour l'icône monochrome. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Verre de la loupe. -->
    <path
        android:pathData="M49,32a17,17 0,1 0,0.01 0z"
        android:strokeWidth="6"
        android:strokeColor="#FF38BDF8" />
    <!-- Manche. -->
    <path
        android:pathData="M61.5,61.5L74,74"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeColor="#FF38BDF8" />
    <!-- Coche : l'audit est fait. -->
    <path
        android:pathData="M41,49.5L46.5,55L57.5,43.5"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#FF10B981" />
</vector>
