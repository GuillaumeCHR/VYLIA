  "security": {
    "description": "Patterns de capacités typiques des logiciels espions. Ils décrivent ce qu'une app PEUT faire, pas ce qu'elle fait : VYLIA ne voit pas le trafic réseau des autres apps.",
    "signals": {
      "INTERNET": "Permission INTERNET déclarée.",
      "BOOT_COMPLETED": "Démarre automatiquement au boot (RECEIVE_BOOT_COMPLETED déclarée).",
      "A11Y_TEXT_EVENTS": "Service d'accessibilité ACTIVÉ abonné aux événements de saisie (TYPE_VIEW_TEXT_CHANGED, TYPE_VIEW_TEXT_SELECTION_CHANGED).",
      "A11Y_WINDOW_CONTENT": "Service d'accessibilité ACTIVÉ capable de lire le contenu des fenêtres (CAPABILITY_CAN_RETRIEVE_WINDOW_CONTENT).",
      "IME_ENABLED": "Clavier (IME) non système activé : il voit toutes les frappes.",
      "FGS_MICROPHONE": "Déclare un service au premier plan de type microphone.",
      "FGS_CAMERA": "Déclare un service au premier plan de type caméra.",
      "NO_LAUNCHER_ICON": "Aucune activité de lancement : l'app n'a pas d'icône dans le tiroir d'apps.",
      "SIDELOADED": "Installée hors store connu (Play Store, F-Droid, Accrescent…). Disponible pour de futurs patterns.",
      "IOC_MATCH": "Package ou certificat de signature présent dans la base d'indicateurs. Calculé par le moteur, pas par le collecteur."
    },
    "condition_syntax": "Atomes : SIGNAL, granted:PERM, declared:PERM, suspicious:PERM (accordée et INATTENDUE ou INTERDITE pour la catégorie), category:ID. Opérateurs : & | ! ( ) et atleast(n: a, b, c).",
    "severity_effects": {
      "certain": { "score_cap": 0 },
      "critical": { "score_cap": 29 },
      "high": { "score_cap": 49 },
      "medium": {}
    },
    "patterns": {
      "KNOWN_STALKERWARE": {
        "label": "Stalkerware connu",
        "severity": "certain",
        "description": "Le package ou le certificat de signature figure dans une base publique d'indicateurs de stalkerwares.",
        "when": "IOC_MATCH"
      },
      "KEYLOGGER_CAPABLE": {
        "label": "Capacité de type keylogger",
        "severity": "critical",
        "description": "Peut lire ce que vous tapez (service d'accessibilité ou clavier tiers) et dispose d'un accès Internet.",
        "when": "INTERNET & ((suspicious:BIND_ACCESSIBILITY_SERVICE & A11Y_TEXT_EVENTS) | IME_ENABLED)",
        "exempt_packages": ["com.google.android.inputmethod.latin"]
      },
      "COVERT_RECORDING": {
        "label": "Enregistrement en arrière-plan",
        "severity": "critical",
        "description": "Peut enregistrer le micro ou la caméra en arrière-plan, démarre au boot et dispose d'un accès Internet, sans que la finalité de l'app le justifie.",
        "when": "INTERNET & BOOT_COMPLETED & ((suspicious:RECORD_AUDIO & FGS_MICROPHONE) | (suspicious:CAMERA & FGS_CAMERA))"
      },
      "STALKERWARE_PROFILE": {
        "label": "Profil de logiciel de surveillance",
        "severity": "critical",
        "description": "Icône cachée et au moins deux accès très sensibles accordés : profil typique d'un logiciel de surveillance.",
        "when": "NO_LAUNCHER_ICON & atleast(2: granted:ACCESS_BACKGROUND_LOCATION, granted:READ_SMS, granted:READ_CALL_LOG, granted:RECORD_AUDIO, granted:BIND_NOTIFICATION_LISTENER_SERVICE, granted:BIND_ACCESSIBILITY_SERVICE, granted:BIND_DEVICE_ADMIN)"
      },
      "OVERLAY_TROJAN": {
        "label": "Combinaison lecture d'écran + superposition",
        "severity": "high",
        "description": "Peut lire l'écran (accessibilité) et dessiner par-dessus les autres apps : combinaison utilisée par les chevaux de Troie bancaires.",
        "when": "suspicious:BIND_ACCESSIBILITY_SERVICE & granted:SYSTEM_ALERT_WINDOW"
      }
    }
  },

